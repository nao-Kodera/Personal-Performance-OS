# API のオリジン。
#
# 未設定なら http://localhost:5238（`dotnet run` の http プロファイル）を使う。
# docker compose で起動する場合は http://localhost:5080 を指定する。
#
# バックエンドの CORS 許可オリジン（backend/src/PerformanceOs.Api/appsettings.json の
# Cors:AllowedOrigins）に、この開発サーバーの http://localhost:5173 が
# 含まれている必要がある。
VITE_API_BASE_URL=http://localhost:5238
